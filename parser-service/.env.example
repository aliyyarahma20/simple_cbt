# Salin ke .env lalu isi. JANGAN commit file .env
PARSER_API_KEY=ganti-dengan-string-acak-panjang
MAX_FILE_MB=20
MAX_ZIP_FILES=500
MAX_UNZIPPED_MB=200
# Sesuaikan dengan isi enum di Supabase (kosongkan untuk memakai nilai bawaan)
# ENUM_JSON={"question_type":"MULTIPLE_CHOICE","exam_status":"DRAFT","import_status":"PENDING"}
# 1 = ikut isi kolom usulan (subject_id, review_level, dst.); 0 = hanya kolom yang sudah ada di DB
MODE_DB_BARU=0
